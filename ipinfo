# ── Helpers ─────────────────────────────────────────────────────────────────

def parse_ip(raw: str) -> ipaddress.IPv4Address | ipaddress.IPv6Address:
    """Convierte una cadena en objeto IP; lanza ValueError si no es válida."""
    return ipaddress.ip_address(raw.strip())


def classify_private(ip) -> str | None:
    """Devuelve etiqueta si la IP es privada/reservada."""
    checks = {
        ip.is_loopback:          "Loopback (127.x / ::1)",
        ip.is_link_local:        "Link-local (169.254.x.x / fe80::)",
        ip.is_private:           "Privada (RFC 1918 / ULA)",
        ip.is_reserved:          "Reservada (IETF)",
        ip.is_multicast:         "Multicast",
        ip.is_unspecified:       "No especificada (0.0.0.0 / ::)",
    }
    if isinstance(ip, ipaddress.IPv4Address) and ip == ipaddress.IPv4Address("255.255.255.255"):
        return "Broadcast limitado"
    for condition, label in checks.items():
        if condition:
            return label
    return None


def match_ranges(ip, ranges: list[str]) -> bool:
    net_type = ipaddress.IPv4Network if ip.version == 4 else ipaddress.IPv6Network
    for cidr in ranges:
        try:
            if ip in net_type(cidr):
                return True
        except ValueError:
            pass
    return False


def detect_cdn(ip) -> str | None:
    for name, ranges in KNOWN_CDN.items():
        if match_ranges(ip, ranges):
            return name
    return None


def reverse_dns(ip_str: str) -> str:
    try:
        host = socket.gethostbyaddr(ip_str)[0]
        return host
    except Exception:
        return "—"


def fetch_geoip(ip_str: str) -> dict:
    """Consulta ip-api.com (gratuito, sin clave)."""
    url = f"http://ip-api.com/json/{ip_str}?fields=status,country,regionName,city,isp,org,as,proxy,hosting"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "ipinfo-script/1.0"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            return json.loads(resp.read())
    except Exception:
        return {}


# ── Salida ───────────────────────────────────────────────────────────────────

RESET  = "\033[0m"
BOLD   = "\033[1m"
GREEN  = "\033[92m"
YELLOW = "\033[93m"
RED    = "\033[91m"
CYAN   = "\033[96m"
BLUE   = "\033[94m"
GRAY   = "\033[90m"

def c(color, text):
    return f"{color}{text}{RESET}"

def header(text):
    print(f"\n{BOLD}{CYAN}{'─'*50}{RESET}")
    print(f"  {BOLD}{text}{RESET}")
    print(f"{BOLD}{CYAN}{'─'*50}{RESET}")

def row(label, value, color=None):
    label_str = f"  {GRAY}{label:<22}{RESET}"
    val_str = c(color, value) if color else value
    print(f"{label_str}{val_str}")


# ── Análisis principal ───────────────────────────────────────────────────────

def analyze(raw: str, offline: bool = False):
    try:
        ip = parse_ip(raw)
    except ValueError:
        print(c(RED, f"[!] '{raw}' no es una dirección IP válida."))
        return

    header(f"Análisis de {ip}")
    row("Versión", f"IPv{ip.version}", BLUE)

    # ── Clasificación privada / pública ──────────────────────────────────────
    private_label = classify_private(ip)
    if private_label:
        row("Tipo", private_label, YELLOW)
        row("Visibilidad", "No enrutable / Privada", YELLOW)
    else:
        row("Tipo", "Pública", GREEN)
        row("Visibilidad", "Enrutable en Internet", GREEN)

    # ── CDN / Proveedor conocido ─────────────────────────────────────────────
    cdn = detect_cdn(ip)
    if cdn:
        row("CDN / Proveedor", cdn, YELLOW)

    # ── DNS inverso ──────────────────────────────────────────────────────────
    rdns = reverse_dns(str(ip))
    row("DNS inverso", rdns, GRAY if rdns == "—" else CYAN)

    # ── Información online (GeoIP) ───────────────────────────────────────────
    if not offline and not private_label:
        geo = fetch_geoip(str(ip))
        if geo.get("status") == "success":
            row("País", geo.get("country", "—"))
            row("Región / Ciudad", f"{geo.get('regionName','—')} / {geo.get('city','—')}")
            row("ISP", geo.get("isp", "—"))
            row("Organización", geo.get("org", "—"))
            row("ASN", geo.get("as", "—"))
            if geo.get("proxy"):
                row("Proxy / VPN", "Sí (detectado)", RED)
            if geo.get("hosting"):
                row("Hosting / Datacenter", "Sí", YELLOW)
        else:
            row("GeoIP", "No disponible (sin conexión o límite alcanzado)", GRAY)
    elif offline:
        row("GeoIP", "Desactivado (modo --offline)", GRAY)
    elif private_label:
        row("GeoIP", "No aplica (IP privada)", GRAY)

    # ── Resumen de riesgo ────────────────────────────────────────────────────
    print()
    flags = []
    if cdn == "Cloudflare":
        flags.append(c(YELLOW, "⚠  IP de Cloudflare (proxy/CDN) — la IP real del servidor puede diferir"))
    if cdn and cdn != "Cloudflare":
        flags.append(c(YELLOW, f"⚠  IP de infraestructura {cdn} — posible servicio cloud"))
    if not private_label and not cdn:
        flags.append(c(GREEN, "✔  IP pública directa sin CDN conocida"))
    if private_label:
        flags.append(c(YELLOW, "ℹ  IP privada — solo accesible en red local"))

    for f in flags:
        print(f"  {f}")
    print()


# ── CLI ──────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="ipinfo",
        description="Clasifica una o varias IPs: privada, pública, CDN, etc.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Ejemplos:
  ipinfo 1.1.1.1
  ipinfo 192.168.1.1 10.0.0.1 8.8.8.8
  ipinfo --offline 104.16.0.1
""",
    )
    parser.add_argument("ips", nargs="+", metavar="IP", help="Dirección(es) IP a analizar")
    parser.add_argument("--offline", action="store_true", help="No consultar servicios externos (GeoIP)")
    args = parser.parse_args()

    for ip in args.ips:
        analyze(ip, offline=args.offline)


if __name__ == "__main__":
    main()
